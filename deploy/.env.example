# ---------------------------------------------------------------------------
# rewind configuration. Copy to .env (never commit .env!) and fill in.
# Comments must stay on their own lines (some .env parsers don't strip
# trailing comments).
# ---------------------------------------------------------------------------

# --- Twitch API (required) -------------------------------------------------
# Create an app at https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost   Category: Other   Client type: Confidential
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: "auth-token" cookie of an account with Turbo (or a sub on the
# channel) -> recordings without ad breaks. See README ("Werbung").
# Checked every 6 h; if it expires, recording continues without it and
# /admin shows a warning.
TWITCH_USER_OAUTH=

# Optional: channels to add on first start (comma separated). Channels can
# also be added any time in the web UI under /admin.
CHANNELS=

# --- Management ------------------------------------------------------------
# Protects /admin actions (add/remove channels, delete VODs). Viewing never
# needs a login. Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# --- Recording -------------------------------------------------------------
# parallel recordings
MAX_CONCURRENT=3
# streamlink quality selector
QUALITY=best
# how often Twitch is asked who is live
POLL_INTERVAL=30s
# reconnects within this window continue the same VOD
OFFLINE_GRACE=3m
# don't start new recordings below this much free local disk
MIN_FREE_GB=15
# parallel post-processing jobs (remux, previews, chat)
FINALIZE_WORKERS=1
# seek preview density
STORYBOARD_INTERVAL=20s
# chat replay file size
CHAT_CHUNK=5m
# 7TV / BTTV / FFZ emotes in the chat replay
THIRD_PARTY_EMOTES=true
# Extra streamlink flags. Example for 1440p/HEVC/AV1 where Twitch offers it
# (plays in the native apps; browsers may lack HEVC support):
#   STREAMLINK_ARGS=--twitch-supported-codecs h264,h265,av1
STREAMLINK_ARGS=

# --- Server / paths on the host ----------------------------------------------
# VPN IP of the server (WireGuard/Tailscale). 127.0.0.1 = local only
BIND_ADDR=10.8.0.1
HTTP_PORT=8080
DATA_PATH=./data
RECORDINGS_PATH=/srv/rewind/recordings
ARCHIVE_PATH=/mnt/storagebox/rewind
IMAGE_TAG=latest
TZ=Europe/Berlin
# debug | info | warn | error
LOG_LEVEL=info
