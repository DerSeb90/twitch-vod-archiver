<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds shrink resources. audio_service looks its notification icons
  up by name at runtime (getIdentifier), so the shrinker sees no reference and
  drops them; the media notification then fails with "You must specify an icon
  resource id to build a CustomAction". Keep them explicitly.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_launcher_monochrome" />
